DATABASE_URL=sqlite:///./climatechain.db
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_CACHE_TTL=600
OVERVIEW_CACHE_TTL=300
MODEL_PATH=ml/artifacts/rainfall_indicator_config.json
MODEL_VERSION=rainfall-indicator-v1

# EVM Blockchain configuration (Sepolia testnet)
CHAIN_ID=11155111
RPC_URL=https://rpc.sepolia.org
# Aliases accepted by the API for hosted platforms: ETH_RPC_URL, SEPOLIA_RPC_URL
DEPLOYER_PRIVATE_KEY=
# Alias accepted by the API: SIGNER_PRIVATE_KEY
CONTRACT_ADDRESS=

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:3000
ALLOW_ALL_ORIGINS=false
PORT=8000
